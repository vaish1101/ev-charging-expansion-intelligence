// Auto-generated from the final PBIP semantic model.
// Canonical executable definitions remain in EV Charging Intelligence.SemanticModel/definition/tables/.

// Table: Regional KPI | Format: #,0
Registered BEVs :=
SUM ( 'Regional KPI'[registered_bev_passenger_car_stock] )

// Table: Regional KPI | Format: #,0
Registered Passenger Cars :=
SUM ( 'Regional KPI'[registered_passenger_car_stock] )

// Table: Regional KPI | Format: #,0
In-Service Charging Facilities :=
SUM ( 'Regional KPI'[in_service_registered_charging_facilities] )

// Table: Regional KPI | Format: #,0
In-Service Charging Points :=
SUM ( 'Regional KPI'[in_service_registered_charging_points] )

// Table: Regional KPI | Format: #,0
In-Service Normal Charging Points :=
SUM ( 'Regional KPI'[in_service_registered_normal_charging_points] )

// Table: Regional KPI | Format: #,0
In-Service Fast Charging Points :=
SUM ( 'Regional KPI'[in_service_registered_fast_charging_points] )

// Table: Regional KPI
Screening Cohort :=
VAR t = [Charging Points per 1,000 BEVs] VAR f = [Fast Charging Points per 1,000 BEVs] RETURN SWITCH ( TRUE (), t < 84.6839 && f < 25.2989, "Below both medians", f < 25.2989, "Below fast median only", t < 84.6839, "Below total median only", "At or above both medians" )

// Table: Regional KPI | Format: #,0.00
Scatter Fast - At or Above Both :=
IF ( [Screening Cohort] = "At or above both medians", [Fast Charging Points per 1,000 BEVs] )

// Table: Regional KPI | Format: #,0.00
Scatter Fast - Below Fast Only :=
IF ( [Screening Cohort] = "Below fast median only", [Fast Charging Points per 1,000 BEVs] )

// Table: Regional KPI | Format: #,0.00
Scatter Fast - Below Total Only :=
IF ( [Screening Cohort] = "Below total median only", [Fast Charging Points per 1,000 BEVs] )

// Table: Regional KPI | Format: #,0.00
Scatter Fast - Below Both :=
IF ( [Screening Cohort] = "Below both medians", [Fast Charging Points per 1,000 BEVs] )

// Table: Regional KPI | Format: #,0
Investigation Attention Score :=
VAR marketRank = RANKX ( ALL ( 'Analysis Region'[analysis_region_sk], 'Analysis Region'[Region] ), CALCULATE ( [Registered BEVs] ), , DESC, DENSE ) VAR cohort = [Screening Cohort] RETURN IF ( marketRank <= 100 && cohort <> "At or above both medians", IF ( cohort = "Below both medians", 2000000000, 1000000000 ) + [Registered BEVs] )

// Table: Regional KPI | Format: 0
Investigation Rank :=
VAR candidates = FILTER ( ALL ( 'Analysis Region'[analysis_region_sk], 'Analysis Region'[Region] ), NOT ISBLANK ( CALCULATE ( [Investigation Attention Score] ) ) ) RETURN IF ( NOT ISBLANK ( [Investigation Attention Score] ), RANKX ( candidates, CALCULATE ( [Investigation Attention Score] ), , DESC, DENSE ) )

// Table: Regional KPI | Format: #,0
Top 10 Investigation BEVs :=
IF ( [Investigation Rank] <= 10, [Registered BEVs] )

// Table: Regional KPI | Format: #,0
Top 10 BEV Markets :=
VAR marketRank = RANKX ( ALL ( 'Analysis Region'[analysis_region_sk], 'Analysis Region'[Region] ), CALCULATE ( [Registered BEVs] ), , DESC, DENSE ) RETURN IF ( marketRank <= 10, [Registered BEVs] )

// Table: Regional KPI | Format: 0.0%;-0.0%;0.0%
Fast Gap Below :=
VAR gap = DIVIDE ( [Fast Charging Points per 1,000 BEVs] - 25.2989, 25.2989 ) RETURN IF ( [Registered BEVs] >= 20000 && gap < 0, gap )

// Table: Regional KPI | Format: 0.0%;-0.0%;0.0%
Fast Gap Above :=
VAR gap = DIVIDE ( [Fast Charging Points per 1,000 BEVs] - 25.2989, 25.2989 ) RETURN IF ( [Registered BEVs] >= 20000 && gap >= 0, gap )

// Table: Regional KPI | Format: 0.0%;-0.0%;0.0%
Fast Gap Sort :=
VAR gap = DIVIDE ( [Fast Charging Points per 1,000 BEVs] - 25.2989, 25.2989 ) RETURN IF ( [Registered BEVs] >= 20000, gap )

// Table: Regional KPI | Format: #,0
Above Both :=
VAR marketRank = RANKX ( ALL ( 'Analysis Region'[analysis_region_sk], 'Analysis Region'[Region] ), CALCULATE ( [Registered BEVs] ), , DESC, DENSE ) RETURN IF ( marketRank <= 10 && [Screening Cohort] = "At or above both medians", [Registered BEVs] )

// Table: Regional KPI | Format: #,0
Fast Gap :=
VAR marketRank = RANKX ( ALL ( 'Analysis Region'[analysis_region_sk], 'Analysis Region'[Region] ), CALCULATE ( [Registered BEVs] ), , DESC, DENSE ) RETURN IF ( marketRank <= 10 && [Screening Cohort] = "Below fast median only", [Registered BEVs] )

// Table: Regional KPI | Format: #,0
Total Gap :=
VAR marketRank = RANKX ( ALL ( 'Analysis Region'[analysis_region_sk], 'Analysis Region'[Region] ), CALCULATE ( [Registered BEVs] ), , DESC, DENSE ) RETURN IF ( marketRank <= 10 && [Screening Cohort] = "Below total median only", [Registered BEVs] )

// Table: Regional KPI | Format: #,0
Both Gaps :=
VAR marketRank = RANKX ( ALL ( 'Analysis Region'[analysis_region_sk], 'Analysis Region'[Region] ), CALCULATE ( [Registered BEVs] ), , DESC, DENSE ) RETURN IF ( marketRank <= 10 && [Screening Cohort] = "Below both medians", [Registered BEVs] )

// Table: Regional KPI | Format: #,0.00
Registered Nominal Power of In-Service Charging Facilities :=
SUM ( 'Regional KPI'[in_service_registered_facility_nominal_power_kw] )

// Table: Regional KPI
Registered BEVs Display :=
FORMAT ( DIVIDE ( [Registered BEVs], 1000000 ), "0.00" ) & "M"

// Table: Regional KPI
Public Charging Points Display :=
FORMAT ( DIVIDE ( [In-Service Charging Points], 1000 ), "0.0" ) & "K"

// Table: Regional KPI
Fast Charging Points Display :=
FORMAT ( DIVIDE ( [In-Service Fast Charging Points], 1000 ), "0.0" ) & "K"

// Table: Regional KPI | Format: 0.00\%
BEV Penetration :=
SELECTEDVALUE ( 'Regional KPI'[bev_penetration_percent] )

// Table: Regional KPI | Format: 0.00%
National BEV Penetration :=
DIVIDE ( [Registered BEVs], [Registered Passenger Cars] )

// Table: Regional KPI | Format: #,0.00
Charging Points per 1,000 BEVs :=
SELECTEDVALUE ( 'Regional KPI'[in_service_registered_charging_points_per_1000_bevs] )

// Table: Regional KPI | Format: #,0.00
Fast Charging Points per 1,000 BEVs :=
SELECTEDVALUE ( 'Regional KPI'[in_service_registered_fast_charging_points_per_1000_bevs] )

// Table: Regional KPI | Format: #,0.00
Charging Facilities per 1,000 BEVs :=
SELECTEDVALUE ( 'Regional KPI'[in_service_registered_charging_facilities_per_1000_bevs] )

// Table: Regional KPI | Format: #,0.00
Registered Nominal Power per 1,000 BEVs :=
SELECTEDVALUE ( 'Regional KPI'[in_service_registered_facility_nominal_power_kw_per_1000_bevs] )

// Table: Regional KPI | Format: 0.00\%
Regional Median - BEV Penetration :=
VAR regions = CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ) RETURN MEDIANX ( regions, VAR currentRegion = 'Analysis Region'[analysis_region_sk] RETURN CALCULATE ( MAX ( 'Regional KPI'[bev_penetration_percent] ), REMOVEFILTERS ( 'Analysis Region' ), TREATAS ( { currentRegion }, 'Analysis Region'[analysis_region_sk] ) ) )

// Table: Regional KPI | Format: #,0.00
Regional Median - Charging Points per 1,000 BEVs :=
VAR regions = CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ) RETURN MEDIANX ( regions, VAR currentRegion = 'Analysis Region'[analysis_region_sk] RETURN CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_charging_points_per_1000_bevs] ), REMOVEFILTERS ( 'Analysis Region' ), TREATAS ( { currentRegion }, 'Analysis Region'[analysis_region_sk] ) ) )

// Table: Regional KPI | Format: #,0.00
Regional Median - Fast Charging Points per 1,000 BEVs :=
VAR regions = CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ) RETURN MEDIANX ( regions, VAR currentRegion = 'Analysis Region'[analysis_region_sk] RETURN CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_fast_charging_points_per_1000_bevs] ), REMOVEFILTERS ( 'Analysis Region' ), TREATAS ( { currentRegion }, 'Analysis Region'[analysis_region_sk] ) ) )

// Table: Regional KPI | Format: #,0.00
Regional Median - Charging Facilities per 1,000 BEVs :=
VAR regions = CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ) RETURN MEDIANX ( regions, VAR currentRegion = 'Analysis Region'[analysis_region_sk] RETURN CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_charging_facilities_per_1000_bevs] ), REMOVEFILTERS ( 'Analysis Region' ), TREATAS ( { currentRegion }, 'Analysis Region'[analysis_region_sk] ) ) )

// Table: Regional KPI | Format: #,0.00
Regional Median - Registered Nominal Power per 1,000 BEVs :=
VAR regions = CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ) RETURN MEDIANX ( regions, VAR currentRegion = 'Analysis Region'[analysis_region_sk] RETURN CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_facility_nominal_power_kw_per_1000_bevs] ), REMOVEFILTERS ( 'Analysis Region' ), TREATAS ( { currentRegion }, 'Analysis Region'[analysis_region_sk] ) ) )

// Table: Regional KPI | Format: +0.00\%;-0.00\%;0.00\%
BEV Penetration vs Regional Median (pp) :=
[BEV Penetration] - [Regional Median - BEV Penetration]

// Table: Regional KPI | Format: +#,0.00;-#,0.00;0.00
Charging Points vs Regional Median :=
[Charging Points per 1,000 BEVs] - [Regional Median - Charging Points per 1,000 BEVs]

// Table: Regional KPI | Format: +#,0.00;-#,0.00;0.00
Fast Charging Points vs Regional Median :=
[Fast Charging Points per 1,000 BEVs] - [Regional Median - Fast Charging Points per 1,000 BEVs]

// Table: Regional KPI | Format: +#,0.00;-#,0.00;0.00
Charging Facilities vs Regional Median :=
[Charging Facilities per 1,000 BEVs] - [Regional Median - Charging Facilities per 1,000 BEVs]

// Table: Regional KPI | Format: +#,0.00;-#,0.00;0.00
Registered Nominal Power vs Regional Median :=
[Registered Nominal Power per 1,000 BEVs] - [Regional Median - Registered Nominal Power per 1,000 BEVs]

// Table: Regional KPI | Format: +0.0%;-0.0%;0.0%
Charging Points % vs Regional Median :=
DIVIDE ( [Charging Points vs Regional Median], [Regional Median - Charging Points per 1,000 BEVs] )

// Table: Regional KPI | Format: +0.0%;-0.0%;0.0%
Fast Charging Points % vs Regional Median :=
DIVIDE ( [Fast Charging Points vs Regional Median], [Regional Median - Fast Charging Points per 1,000 BEVs] )

// Table: Regional KPI | Format: +0.0%;-0.0%;0.0%
Charging Facilities % vs Regional Median :=
DIVIDE ( [Charging Facilities vs Regional Median], [Regional Median - Charging Facilities per 1,000 BEVs] )

// Table: Regional KPI | Format: +0.0%;-0.0%;0.0%
Registered Nominal Power % vs Regional Median :=
DIVIDE ( [Registered Nominal Power vs Regional Median], [Regional Median - Registered Nominal Power per 1,000 BEVs] )

// Table: Regional KPI | Format: 0.0%
Presentation - Fast Share of In-Service Points :=
DIVIDE ( [In-Service Fast Charging Points], [In-Service Charging Points] )

// Table: Regional KPI | Format: #,0
Region Count :=
DISTINCTCOUNT ( 'Analysis Region'[analysis_region_sk] )

// Table: Regional KPI | Format: #,0
Regions Above Total Median but Below Fast Median :=
VAR tm = [Regional Median - Charging Points per 1,000 BEVs] VAR fm = [Regional Median - Fast Charging Points per 1,000 BEVs] RETURN COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ), CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_charging_points_per_1000_bevs] ) ) > tm && CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_fast_charging_points_per_1000_bevs] ) ) < fm ) )

// Table: Regional KPI | Format: #,0
Regions Above Total Median and Above Fast Median :=
VAR tm = [Regional Median - Charging Points per 1,000 BEVs] VAR fm = [Regional Median - Fast Charging Points per 1,000 BEVs] RETURN COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ), CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_charging_points_per_1000_bevs] ) ) >= tm && CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_fast_charging_points_per_1000_bevs] ) ) >= fm ) )

// Table: Regional KPI | Format: #,0
Regions Below Total Median and Above Fast Median :=
VAR tm = [Regional Median - Charging Points per 1,000 BEVs] VAR fm = [Regional Median - Fast Charging Points per 1,000 BEVs] RETURN COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ), CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_charging_points_per_1000_bevs] ) ) < tm && CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_fast_charging_points_per_1000_bevs] ) ) >= fm ) )

// Table: Regional KPI | Format: #,0
Regions Below Total Median and Below Fast Median :=
VAR tm = [Regional Median - Charging Points per 1,000 BEVs] VAR fm = [Regional Median - Fast Charging Points per 1,000 BEVs] RETURN COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( 'Analysis Region'[analysis_region_sk] ), REMOVEFILTERS ( 'Analysis Region' ) ), CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_charging_points_per_1000_bevs] ) ) < tm && CALCULATE ( MAX ( 'Regional KPI'[in_service_registered_fast_charging_points_per_1000_bevs] ) ) < fm ) )

// Table: Regional KPI | Format: #,0
Top 100 BEV Regions Below Both Medians :=
VAR tm = [Regional Median - Charging Points per 1,000 BEVs] VAR fm = [Regional Median - Fast Charging Points per 1,000 BEVs] VAR top100 = TOPN ( 100, CALCULATETABLE ( 'Regional KPI', REMOVEFILTERS ( 'Analysis Region' ) ), 'Regional KPI'[registered_bev_passenger_car_stock], DESC, 'Regional KPI'[analysis_region_sk], ASC ) RETURN COUNTROWS ( FILTER ( top100, 'Regional KPI'[in_service_registered_charging_points_per_1000_bevs] < tm && 'Regional KPI'[in_service_registered_fast_charging_points_per_1000_bevs] < fm ) )

// Table: Regional KPI
Top 100 Below Both Display :=
FORMAT ( [Top 100 BEV Regions Below Both Medians], "0" ) & " of 100"

// Table: Regional KPI
Screening Signal :=
VAR totalDelta = [Charging Points vs Regional Median] VAR fastDelta = [Fast Charging Points vs Regional Median] RETURN SWITCH ( TRUE (), ISBLANK ( totalDelta ) || ISBLANK ( fastDelta ), BLANK (), totalDelta < 0 && fastDelta < 0, "Below both medians", totalDelta < 0, "Below total median", fastDelta < 0, "Below fast median", "Above both medians" )

// Table: Regional KPI
Selected Region :=
SELECTEDVALUE ( 'Analysis Region'[Region], "Select one analysis region" )

// Table: Regional KPI | Format: #,0
Selected Registered BEVs :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), [Registered BEVs] )

// Table: Regional KPI
Selected Registered BEVs Display :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), SUBSTITUTE ( FORMAT ( [Registered BEVs], "#,0" ), ".", "," ) )

// Table: Regional KPI | Format: #,0.00
Selected Total Points per 1,000 BEVs :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), [Charging Points per 1,000 BEVs] )

// Table: Regional KPI | Format: #,0.00
Selected Fast Points per 1,000 BEVs :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), [Fast Charging Points per 1,000 BEVs] )

// Table: Regional KPI | Format: #,0
BEV Stock Rank :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), RANKX ( ALL ( 'Analysis Region'[analysis_region_sk], 'Analysis Region'[Region] ), CALCULATE ( [Registered BEVs] ), , DESC, DENSE ) )

// Table: Regional KPI
BEV Stock Rank Support :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), "BEV stock rank: " & FORMAT ( [BEV Stock Rank], "0" ) & " of 400" )

// Table: Regional KPI
Total Provision Support :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), FORMAT ( ABS ( [Charging Points % vs Regional Median] ), "0.0%" ) & " " & IF ( [Charging Points % vs Regional Median] < 0, "below", "above" ) & " regional median" )

// Table: Regional KPI
Fast Provision Support :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), FORMAT ( ABS ( [Fast Charging Points % vs Regional Median] ), "0.0%" ) & " " & IF ( [Fast Charging Points % vs Regional Median] < 0, "below", "above" ) & " regional median" )

// Table: Regional KPI
Dynamic Region Summary :=
VAR r = [Selected Region] VAR rk = [BEV Stock Rank] VAR suffix = SWITCH ( TRUE (), MOD ( rk, 100 ) IN { 11, 12, 13 }, "th", MOD ( rk, 10 ) = 1, "st", MOD ( rk, 10 ) = 2, "nd", MOD ( rk, 10 ) = 3, "rd", "th" ) VAR totalDelta = [Charging Points vs Regional Median] VAR fastDelta = [Fast Charging Points vs Regional Median] VAR positionText = SWITCH ( TRUE (), totalDelta < 0 && fastDelta < 0, "below the regional median on both total and fast charging provision", totalDelta < 0, "below the regional median on total charging provision", fastDelta < 0, "below the regional median on fast charging provision", "above the regional median on both total and fast charging provision" ) RETURN IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), r & " ranks " & FORMAT ( rk, "0" ) & suffix & " by registered BEV stock and is " & positionText & ".", "Select one region to view its profile." )

// Table: Regional KPI
Infrastructure Detail :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), FORMAT ( [In-Service Charging Facilities], "#,0" ) & " facilities  |  " & FORMAT ( [In-Service Normal Charging Points], "#,0" ) & " normal  |  " & FORMAT ( [In-Service Fast Charging Points], "#,0" ) & " fast  |  " & FORMAT ( DIVIDE ( [Registered Nominal Power of In-Service Charging Facilities], 1000 ), "0.00" ) & "K kW" )

// Table: Regional KPI
Region Profile Title :=
"Region Profile: " & [Selected Region]

// Table: Regional KPI
Dataset Publication State :=
SELECTEDVALUE ( Dataset[publication_state], "No published dataset selected" )

// Table: Regional KPI
Gold DQ Status :=
VAR f = SELECTEDVALUE ( Dataset[failed_dq_checks] ) VAR p = SELECTEDVALUE ( Dataset[passed_dq_checks] ) RETURN IF ( NOT ISBLANK ( f ), FORMAT ( p, "#,0" ) & " passed / " & FORMAT ( f, "#,0" ) & " failed" )

// Table: Regional KPI
Source Date Disclosure :=
VAR k = SELECTEDVALUE ( Dataset[kba_reference_date] ) VAR b = SELECTEDVALUE ( Dataset[bnetza_reference_date] ) VAR d = SELECTEDVALUE ( Dataset[destatis_reference_date] ) VAR l = SELECTEDVALUE ( Dataset[kba_to_bnetza_lag_days] ) RETURN "KBA " & FORMAT ( k, "dd MMM yyyy" ) & "  |  BNetzA " & FORMAT ( b, "dd MMM yyyy" ) & "  |  Destatis " & FORMAT ( d, "dd MMM yyyy" ) & "  |  KBA to BNetzA lag: " & FORMAT ( l, "0" ) & " days"

// Table: Comparison Metric | Format: #,0.0
Selected Region Value :=
IF ( HASONEVALUE ( 'Analysis Region'[analysis_region_sk] ), SWITCH ( SELECTEDVALUE ( 'Comparison Metric'[Metric] ), "Total points / 1,000 BEVs", [Charging Points per 1,000 BEVs], "Fast points / 1,000 BEVs", [Fast Charging Points per 1,000 BEVs], "Facilities / 1,000 BEVs", [Charging Facilities per 1,000 BEVs] ) )

// Table: Comparison Metric | Format: #,0.0
Regional Median :=
SWITCH ( SELECTEDVALUE ( 'Comparison Metric'[Metric] ), "Total points / 1,000 BEVs", [Regional Median - Charging Points per 1,000 BEVs], "Fast points / 1,000 BEVs", [Regional Median - Fast Charging Points per 1,000 BEVs], "Facilities / 1,000 BEVs", [Regional Median - Charging Facilities per 1,000 BEVs] )

// Table: Comparison Metric | Format: +#,0.0;-#,0.0;0.0
Signed Delta :=
IF ( NOT ISBLANK ( [Selected Region Value] ), [Selected Region Value] - [Regional Median] )

// Table: Comparison Metric | Format: +0.0%;-0.0%;0.0%
Delta Percent :=
DIVIDE ( [Signed Delta], [Regional Median] )
